{
  "$defs": {
    "VocabularyConceptEvidence": {
      "additionalProperties": false,
      "description": "Exact-URI status evidence pinned to one persisted vocabulary release.",
      "properties": {
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved",
            "unverified",
            "invalid",
            "deprecated",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "replacement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement"
        }
      },
      "required": [
        "uri",
        "status"
      ],
      "title": "VocabularyConceptEvidence",
      "type": "object"
    },
    "VocabularyDefinition": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "release": {
          "minLength": 1,
          "title": "Release",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "members": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Members",
          "type": "array"
        },
        "concepts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VocabularyConceptEvidence"
          },
          "title": "Concepts",
          "type": "array"
        },
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        }
      },
      "required": [
        "uri",
        "release",
        "source"
      ],
      "title": "VocabularyDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-selected immutable evidence snapshot; absence in a partial set is unknown.",
  "properties": {
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "vocabularies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VocabularyDefinition"
      },
      "title": "Vocabularies",
      "type": "array"
    }
  },
  "title": "VocabularyRegistry",
  "type": "object"
}
